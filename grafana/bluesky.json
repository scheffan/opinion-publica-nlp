    {
      "id": 10,
      "type": "barchart",
      "title": "Emociones por tema · últimos 3 meses",
      "description": "Emoción principal de cada post según el modelo, sobre los posts con texto analizable. 'Otra' significa que el modelo no encontró una emoción clara (por ejemplo, un post informativo).",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_OPINION}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_OPINION}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT etiqueta AS \"Tema\", round(100.0 * coalesce(sum(posts) FILTER (WHERE emocion = 'enojo'), 0) / sum(posts), 1) AS \"Enojo\", round(100.0 * coalesce(sum(posts) FILTER (WHERE emocion = 'tristeza'), 0) / sum(posts), 1) AS \"Tristeza\", round(100.0 * coalesce(sum(posts) FILTER (WHERE emocion = 'miedo'), 0) / sum(posts), 1) AS \"Miedo\", round(100.0 * coalesce(sum(posts) FILTER (WHERE emocion = 'asco'), 0) / sum(posts), 1) AS \"Asco\", round(100.0 * coalesce(sum(posts) FILTER (WHERE emocion = 'alegria'), 0) / sum(posts), 1) AS \"Alegría\", round(100.0 * coalesce(sum(posts) FILTER (WHERE emocion = 'sorpresa'), 0) / sum(posts), 1) AS \"Sorpresa\", round(100.0 * coalesce(sum(posts) FILTER (WHERE emocion = 'otra'), 0) / sum(posts), 1) AS \"Otra\" FROM v_bsky_emociones_mensual WHERE mes >= (SELECT max(mes) FROM v_bsky_emociones_mensual) - interval '2 months' GROUP BY etiqueta ORDER BY 2 DESC"
        }
      ],
